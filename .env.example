# copy to .env for local runs; Cloud Run gets these via deploy.sh
GOOGLE_CLOUD_PROJECT=inlaid-backbone-506118-k3
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
MODEL=gemini-3.5-flash
GEMMA_MODEL=gemma-3-27b-it

# App Store Connect — the .p8 itself lives ONLY in Secret Manager (asc-private-key)
ASC_KEY_ID=YL98VF4UNZ
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=   # local only; unset in Cloud Run (read from Secret Manager)
ASC_WEBHOOK_SECRET=

# safety rails
DRY_RUN=true            # real ASC writes need DRY_RUN=false
ALLOW_SUBMIT=false      # AND this, for the final reviewSubmissions PATCH
ALLOWED_APP_IDS=6803901837

# operator facts the API cannot know
REVIEW_CONTACT_FIRST=Ankit
REVIEW_CONTACT_LAST=Bhandari
REVIEW_CONTACT_EMAIL=ankit@utenx.com
REVIEW_CONTACT_PHONE=
SUPPORT_URL=https://byasb.com/snipstash
PRIVACY_URL=https://byasb.com/snipstash/privacy
